# Copy to .env (git-ignored) and use it with: uv run --env-file .env limespec ...
# The user, password and database must match deploy/.env.
LIMESPEC_DATABASE_URL=postgresql://limespec:change-me@127.0.0.1:5432/limespec
# The model servers' key. Make one with
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# The startup script gives it to llama-server (LLAMA_API_KEY); the API sends it.
LIMESPEC_MODEL_API_KEY=change-me
# Serve this index version instead of the live one, to evaluate a candidate built
# with `limespec ingest --no-live`. Leave it unset to serve the live version.
# LIMESPEC_INDEX_VERSION=
# The embedder is Qwen3-Embedding-4B on 8084. A version built with the 0.6B model
# (8081) is served with that model instead:
# LIMESPEC_EMBEDDING_URL=http://127.0.0.1:8081/v1/embeddings
# LIMESPEC_EMBEDDING_MODEL=Qwen3-Embedding-0.6B-f16.gguf
# Traces and metrics go to VictoriaTraces and VictoriaMetrics (compose profile
# "observability"); leave them unset to send none.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:10428/insert/opentelemetry/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:8428/opentelemetry/v1/metrics
# The stable HTTP names (http.server.request.duration, with the route) for the API's
# request metrics and spans.
OTEL_SEMCONV_STABILITY_OPT_IN=http
